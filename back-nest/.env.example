# Database Configuration
MONGODB_URI=mongodb://localhost:27017/budget-app

# JWT Configuration
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server Configuration
PORT=3000

# CORS Configuration (origines séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_CREDENTIALS=true

# Environment
NODE_ENV=development

# AI Assistant
# Gratuit (recommandé tests): groq — https://console.groq.com
AI_PROVIDER=groq
AI_API_KEY=your-groq-api-key
AI_MODEL=llama-3.3-70b-versatile

# Alternatives (changer AI_PROVIDER uniquement):
# gemini  → AI_PROVIDER=gemini  AI_MODEL=gemini-2.0-flash  (https://aistudio.google.com)
# openai  → AI_PROVIDER=openai  AI_MODEL=gpt-4o-mini
# ollama  → AI_PROVIDER=ollama  AI_MODEL=llama3.2  (local, http://localhost:11434)
# deepseek → AI_PROVIDER=deepseek

# AI_BASE_URL=          # optionnel, URL auto selon le provider
AI_MAX_TOOL_ITERATIONS=5
